{
	"__note__": "01/2020 : Final version for simulations of future plant growth. There is a different version for historic plant growth because of different headers.",
	"crop.json": "crop.json",
	"site.json": "site.json",
	"climate.csv": "",

	"climate.csv-options": {
        "no-of-climate-file-header-lines": 2,
        "csv-separator": ",",
        "header-to-acd-names": {
			"windspeed": "wind"
        }
    },
	
	"debug?": false,
	"path-to-output": "./",
	"include-file-base-path": "data/params/",
	
	"output": { 
	  "write-file?": false,
		"file-name": "out.csv",
	
		"csv-options": {
			"include-header-row": true,
			"include-units-row": false,
			"csv-separator": ","
		},

		"obj-outputs?": false,

		"yields-events": [
			"crop", [
				["CM-count", "FIRST"],
				["Year", "LAST"],
				["Crop", "FIRST"],

				["Yield", "LAST"],
				["AbBiom", "LAST"],
				
				["SumNUp", "LAST"],
				["NLeach", "SUM"],

				["Precip", "SUM"],

				["SOC|SOC_percent", [1, 20, "SUM"], "LAST"],
				["SOC-X-Y|SOC_total", [1, 20, "SUM"], "LAST"],
				["NEE", "SUM"],
				["N2O","SUM"]
			],
			{"from": "xxxx-03-01", "to": "xxxx-05-31"}, [
				["CM-count", "LAST"],
				["Year", "LAST"],
				["Crop", "LAST"],				
				["Precip|Precip_spring", "SUM"]
			]
		],

		"__yields-events": [
			"crop", [
				["CM-count", "FIRST"],
				["Year", "LAST"],
				["Crop", "FIRST"],

				["Yield", "LAST"],
				["AbBiom", "LAST"],
				["LAI", "MAX"],
				["EffRootDep", "MAX"],

				["NFert", "SUM"],
				["N", [1, 20, "AVG"]],
				["N|N_30", [1, 3, "AVG"]],
				["N|N_90", [1, 9, "AVG"]],
				["Nstress", "AVG"],
				["Nmin", [1, 20, "AVG"]],
				["Nmin|iniNmin", [1, 20, "FIRST"]],
				["Nmin|finalNmin", [1, 20, "LAST"]],
				["SumNUp", "LAST"],
				["AbBiomNc|AbBiomNc_last", "LAST"],
				["AbBiomNc|AbBiomNc_max", "MAX"],
				["NLeach", "SUM"],

				["PASW", [1, 20, "SUM"]],
				["PASW|PASW_30", [1, 3, "SUM"]],
				["PASW|PASW_90", [1, 9, "SUM"]],
				["Mois", [1, 20, "SUM"]],
				["Mois|Mois_30", [1, 3, "SUM"]],
				["Mois|Mois_90", [1, 9, "SUM"]],
				["WaterContent", [1, 20, "AVG"]],
				
				["Act_ET", "SUM"],
				["Evaporation", "SUM"],
				["Tra", "SUM"],
				["TraDef", "AVG"],

				["Precip", "SUM"],
				["PercolationRate|Drain", [20, "SUM"]]
			],
			{"from": "xxxx-03-01", "to": "xxxx-05-31"}, [
				["CM-count", "LAST"],
				["Year", "LAST"],
				["Crop", "LAST"],

				["Nstress|Nstress_spring", "AVG"],
				["SumNUp|SumNUp_spring", "LAST"],

				["PASW|PASW_spring", [1, 20, "SUM"]],
				["PASW|PASW_30_spring", [1, 3, "SUM"]],
				["PASW|PASW_90_spring", [1, 9, "SUM"]],
				["WaterContent|WaterContent_spring", [1, 20, "AVG"]],
				
				["Act_ET|Act_ET_spring", "SUM"],
				["Evaporation|Evaporation_spring", "SUM"],
				["Tra|Tra_spring", "SUM"],
				["TraDef|TraDef_spring", "AVG"],
				
				["Precip|Precip_spring", "SUM"]
			]
		],

		"backup-pheno-events": [
			"Sowing", [
				"CM-count",
				"Crop",
				"DOY|sdoy"
			],
			"Stage-1", [
				"CM-count",
				"DOY|s1doy"
			],
			"Stage-2", [
				"CM-count",
				"DOY|s2doy"
			],
			"cereal-stem-elongation", [
				"CM-count",
				"DOY|sedoy"
			],
			"Stage-3", [
				"CM-count",
				"DOY|s3doy"
			],
			"Stage-4", [
				"CM-count",
				"DOY|s4doy"
			],
			"Stage-5", [
				"CM-count",
				"DOY|s5doy"
			],
			"Stage-6", [
				"CM-count",
				"DOY|s6doy"
			],
			"Stage-7", [
				"CM-count",
				"DOY|s7doy"
			],
			"Harvest", [
				"CM-count",
				"Year",
				"DOY|hdoy"
			],
			"Harvest", [
				"CM-count",
				"Stage|hstage"
			]
		]
	},

	"NumberOfLayers": 20,
	"LayerThickness": [0.1, "m"],

	"UseSecondaryYields": false,
	"NitrogenResponseOn": true,
	"WaterDeficitResponseOn": true,
	"EmergenceMoistureControlOn": false,
	"EmergenceFloodingControlOn": false,

	"UseAutomaticIrrigation": false,
	"AutoIrrigationParams": {
		"irrigationParameters": {
			"nitrateConcentration": [0, "mg dm-3"],
			"sulfateConcentration": [0, "mg dm-3"]
		},
		"amount": [0, "mm"],
		"threshold": 0.9
	},

	"UseNMinMineralFertilisingMethod": true,
	"NMinUserParams": { "min": 40, "max": 120, "delayInDays": 10 },
	"NMinFertiliserPartition": ["include-from-file", "mineral-fertilisers/AN.json"],
	"JulianDayAutomaticFertilising": 89
}
